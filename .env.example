# Application
APP_NAME=ResearchLens
APP_ENV=development
DEBUG=True

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Embedding
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector Database
VECTOR_DB=faiss
VECTOR_DB_PATH=storage/faiss_index

# Data
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EVALUATION_DATA_DIR=data/evaluation

# Logging
LOG_LEVEL=INFO